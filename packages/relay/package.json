{
  "name": "@sigilo/relay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node --import tsx --watch src/node-server.ts",
    "start": "node dist/node-server.js",
    "build": "esbuild src/node-server.ts --bundle --platform=node --format=esm --target=node22 --external:fastify --external:@fastify/rate-limit --outdir=dist",
    "test": "node --import tsx --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "dev:worker": "wrangler dev --local",
    "deploy": "wrangler deploy",
    "test:worker": "node scripts/test-worker.mjs"
  },
  "dependencies": {
    "@fastify/rate-limit": "^10.0.0",
    "@sigilo/core": "*",
    "fastify": "^5.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261022.1",
    "esbuild": "^0.25.0",
    "wrangler": "^4.152.0"
  }
}
