# Copie para .env e exporte as variáveis (ou use o gerenciador de processos/contêiner da sua escolha).
# Todas são opcionais; os valores abaixo são os padrões.

HOST=0.0.0.0
PORT=3000

# Arquivo do banco SQLite (relativo à pasta packages/server). Faça backup deste arquivo.
DB_PATH=./data/sigilo.db

# Mensagens NÃO lidas são apagadas depois deste prazo.
MESSAGE_TTL_HOURS=168
SESSION_TTL_DAYS=30
# Validade do código de ativação (conta nova ou "esqueci a senha") e do convite entre redes.
ACTIVATION_TTL_HOURS=72
INVITE_TTL_HOURS=168

# Custo do scrypt para contas novas / troca de senha. Veja docs/ARQUITETURA.md (seção "Custo do KDF no celular").
KDF_N=16384
MIN_KDF_N=16384

# Tentativas erradas de senha antes de bloquear a conta, e por quanto tempo.
MAX_LOGIN_FAILURES=8
LOCK_MINUTES=5

# Ligue (true) quando houver proxy reverso na frente, para o limite por IP enxergar o IP real.
TRUST_PROXY=false
# off para desligar o limite de requisições por IP (só para testes).
RATE_LIMIT=on
LOG=on
