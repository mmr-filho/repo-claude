{
  "name": "sigilo",
  "private": true,
  "version": "0.1.0",
  "description": "Mensageria entre celulares com criptografia ponta a ponta, mensagens que se apagam ap\u00f3s a leitura e redes isoladas administradas por administradores.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev:server": "npm run dev -w @sigilo/server",
    "network:create": "npm run network:create -w @sigilo/server --",
    "mobile": "npm run start -w @sigilo/mobile",
    "test": "npm test --workspaces --if-present",
    "test:e2e": "node e2e/ui.e2e.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "android": "npm run android -w @sigilo/mobile",
    "test:transparencia": "node modules/transparencia/test/fluxo.e2e.mjs"
  },
  "devDependencies": {
    "playwright-core": "^1.56.1"
  }
}
