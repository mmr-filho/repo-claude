# Roteador do OmniSaúde. SITE_ADDRESS define o modo (veja docs/PUBLICACAO-SERVIDOR.md):
#   mm.api.br  → atende o domínio direto, com HTTPS automático (Let's Encrypt) nas portas 80/443
#   :80        → só HTTP interno, atrás de um nginx/Apache que já atende mm.api.br no servidor
#
#   /omnisaude/api/*        → API (o prefixo /omnisaude é removido)
#   /omnisaude/socket.io/*  → API (tempo real: painel, filas, leitos, Libras)
#   /omnisaude/*            → web (Next.js publicado com basePath /omnisaude)
{
	admin off
	servers {
		# Só aceita X-Forwarded-For vindo de proxy na rede privada (o nginx local, no segundo modo);
		# cliente da internet não consegue forjar o IP gravado na trilha de auditoria.
		trusted_proxies static private_ranges
	}
}

{$SITE_ADDRESS:mm.api.br} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(self), microphone=(self), geolocation=()"
		-Server
	}

	@backend path /omnisaude/api /omnisaude/api/* /omnisaude/socket.io /omnisaude/socket.io/*
	handle @backend {
		uri strip_prefix /omnisaude
		reverse_proxy api:3001
	}

	handle /omnisaude* {
		reverse_proxy web:3000
	}

	handle {
		respond "Não encontrado" 404
	}
}
