# Copie para .env e preencha. Para gerar todas as senhas de uma vez, veja docs/PUBLICACAO.md (passo 3).
# Senhas: openssl rand -hex 24 (só letras e números, por irem dentro de URLs de conexão).
# DATA_KEY: openssl rand -base64 32 (exatamente 32 bytes em base64).

PUBLIC_ORIGIN=https://mm.api.br

MASTER_DB_PASSWORD=
POSTGRES_SUPERUSER_PASSWORD=
APP_DB_PASSWORD=
ADMIN_DB_PASSWORD=
BI_DB_PASSWORD=
REPLICATION_PASSWORD=

JWT_SECRET=
DATA_KEY=

# true: cria o tenant de demonstração "demo" com dados fictícios e a senha pública OmniSaude2026.
SEED_DEMO=true

# Cloudflare Tunnel (perfil "tunel"): token mostrado ao criar o túnel no painel Zero Trust.
TUNNEL_TOKEN=

# Opcionais
ANTHROPIC_API_KEY=
LIBRAS_INTERPRETER_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
