# Copie para .env e preencha. Para gerar todas as senhas de uma vez, veja docs/PUBLICACAO-SERVIDOR.md (passo 3).
# Senhas: openssl rand -hex 24 (só letras e números, por irem dentro de URLs de conexão).
# DATA_KEY: openssl rand -base64 32 (exatamente 32 bytes em base64).

PUBLIC_ORIGIN=https://mm.api.br

# Modo padrão: o Caddy atende mm.api.br direto, com HTTPS automático (portas 80 e 443 livres no servidor).
SITE_ADDRESS=mm.api.br
HTTP_PORT=80
HTTPS_PORT=443
TRUST_PROXY=1
# Se um nginx/Apache do servidor já atende mm.api.br, troque as quatro linhas acima por:
#   SITE_ADDRESS=:80
#   HTTP_PORT=127.0.0.1:8080
#   HTTPS_PORT=127.0.0.1:8443
#   TRUST_PROXY=2

MASTER_DB_PASSWORD=
POSTGRES_SUPERUSER_PASSWORD=
APP_DB_PASSWORD=
ADMIN_DB_PASSWORD=
BI_DB_PASSWORD=
REPLICATION_PASSWORD=

JWT_SECRET=
DATA_KEY=

# Conta de operação da plataforma (POST /omnisaude/api/platform/login): cria e suspende tenants.
# E-mail vazio = plataforma@omnisaude.dev. A senha precisa de 10+ caracteres com letras e números.
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=

# true: cria o tenant de demonstração "demo" com dados fictícios e a senha pública OmniSaude2026.
SEED_DEMO=true

# Opcionais
ANTHROPIC_API_KEY=
LIBRAS_INTERPRETER_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
