  cbo            String   @db.Char(6)
  slotMinutes    Int      @default(20) @map("slot_minutes")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")

  unit         Unit            @relation(fields: [unitId], references: [id])
