// ───────────────────────────── Trilha de auditoria ─────────────────────────────

/// Encadeamento SHA-256: cada entrada inclui o hash da anterior. UPDATE e DELETE são bloqueados por gatilho.
model AuditEntry {
  seq         BigInt   @id @default(autoincrement())
  at          DateTime @default(now()) @db.Timestamptz(3)
  userId      String?  @map("user_id") @db.Uuid
  unitId      String?  @map("unit_id") @db.Uuid
  role        String?
  ip          String?
  mfa         Boolean  @default(false)
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  payloadHash String   @map("payload_hash") @db.Char(64)
  prevHash    String   @map("prev_hash") @db.Char(64)
  hash        String   @unique @db.Char(64)

  @@index([entityType, entityId])
  @@index([userId, at])
  @@map("audit_entries")
}
