enum ControlledList {
  A1
  A2
  A3
  B1
  B2
  C1
  C2
  C3
  C4
  C5
}

/// Catálogo institucional padronizado (CATMAT/CATSER).
model Product {
  id                String          @id @default(uuid(7)) @db.Uuid
  code              String          @unique
  catmat            String?
  description       String
  activeIngredient  String?         @map("active_ingredient")
  concentration     String?
  pharmaceuticalForm String?        @map("pharmaceutical_form")
  /// Unidade de dispensação/estoque (CP, AMP, FR, ML, UN...).
  unit              String
  gtin              String?
  /// Imunobiológico (código do e-SUS/RNDS) quando o produto é uma vacina: aparece na sala de vacina.
  vaccineCode       String?         @map("vaccine_code")
  /// Lista da Portaria SVS/MS 344/98 quando controlado.
  controlledList    ControlledList? @map("controlled_list")
  /// Medicamento de alta vigilância: administração exige POP com dupla checagem.
  highAlert         Boolean         @default(false) @map("high_alert")
  antimicrobialRestricted Boolean   @default(false) @map("antimicrobial_restricted")
  active            Boolean         @default(true)
  /// Insumo do controle vetorial (VIG-3a): larvicida ou adulticida. Não aparece na dispensação.
  vectorControl     VectorControlKind? @map("vector_control")

  mappings ProductMapping[]
  lots     StockLot[]
  vectorTreatments VectorTreatment[]

  @@index([gtin])
  @@map("products")
}

/// "De-Para": código do fornecedor/GTIN da nota fiscal para o item do catálogo, com fator de conversão.
