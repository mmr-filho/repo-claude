// tenant_db_<id>: base transacional (OLTP) isolada de cada contratante.
// O prontuário é único dentro do tenant: o que é registrado na UBS aparece na UPA e no hospital da mesma rede.
// As views analíticas (schema "bi") e os gatilhos da trilha de auditoria estão em migrations/*_bi_e_auditoria.

generator client {
  provider     = "prisma-client"
  output       = "../../src/generated/tenant"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Estrutura da rede ─────────────────────────────

enum UnitType {
  UBS
  UPA
  POLICLINICA
  HOSPITAL
  CEO
  SAMU
  CAPS
  FARMACIA_CENTRAL
  ALMOXARIFADO
  LABORATORIO
  /// Unidade de Vigilância em Saúde (tipo 50 do CNES, Portaria SAS/MS 758/2014).
  VIGILANCIA_SAUDE
}

model Unit {
  id        String   @id @default(uuid(7)) @db.Uuid
  cnes      String   @unique @db.Char(7)
  name      String
  type      UnitType
  ibgeCode  String   @map("ibge_code")
  address   String?
  phone     String?
  email     String?
  /// Texto livre, ex.: "Segunda a sexta, 7h às 19h".
  openingHours String? @map("opening_hours")
  latitude  Float?
  longitude Float?
  /// Dados do CNES: tipo de unidade (código), natureza jurídica, esfera de gestão (M/E/D) e atendimento ambulatorial SUS.
  cnesTypeCode  String?   @map("cnes_type_code") @db.Char(2)
  legalNature   String?   @map("legal_nature") @db.Char(4)
  management    String?   @db.Char(1)
  susAmbulatory Boolean?  @map("sus_ambulatory")
  cnesUpdatedAt DateTime? @map("cnes_updated_at")
  /// MANUAL (cadastrada pela gestão) ou CNES (importada).
  source    String   @default("MANUAL")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  assignments    UserAssignment[]
  teams          Team[]
  cnesStaged     CnesProfessional[]
  households     Household[]
  esusBatches    EsusBatch[]
  schedules      Schedule[]
  tickets        Ticket[]
  encounters     Encounter[]
  wards          Ward[]
  stockLocations StockLocation[]

  @@map("units")
  ombudsmanCases OmbudsmanCase[]
  surveys        SatisfactionSurvey[]
  notifications  Notification[]
}

enum Role {
  RECEPCAO
  ENFERMAGEM
  MEDICO
  MULTIPROFISSIONAL
  SERVICO_SOCIAL
  NIR
  FARMACIA
  FATURAMENTO
  GESTOR
  ACS
  /// Vigilância epidemiológica da Secretaria Municipal (alcance de todas as unidades).
  VIGILANCIA_EPIDEMIOLOGICA
  /// Núcleo de vigilância do estabelecimento (alcance da unidade da lotação).
  NUCLEO_VIGILANCIA
  /// Agente de combate às endemias (CBO 515140): visita aos imóveis no app de campo (VIG-3a).
  ACE
  /// Supervisor de campo de endemias: zonas dos agentes, ordens de bloqueio e pendências.
  SUPERVISOR_ENDEMIAS
  /// Coordenação de endemias: parâmetros do bloqueio e estoque de larvicidas.
  COORDENADOR_ENDEMIAS
}

/// Profissionais e colaboradores do tenant. O login é por CPF dentro do tenant.
model User {
  id             String    @id @default(uuid(7)) @db.Uuid
  cpf            String    @unique @db.Char(11)
  cns            String?   @unique @db.Char(15)
  name           String
  socialName     String?   @map("social_name")
  email          String?
  phone          String?
  passwordHash   String    @map("password_hash")
  /// Segredo TOTP (RFC 6238) cifrado com a chave do servidor.
  totpSecret     String?   @map("totp_secret")
  mfaEnabled     Boolean   @default(false) @map("mfa_enabled")
  active         Boolean   @default(true)
  failedLogins   Int       @default(0) @map("failed_logins")
  lockedUntil    DateTime? @map("locked_until")
  lastLoginAt    DateTime? @map("last_login_at")
  /// Senha provisória (cadastro ou redefinição pela administração): só a troca de senha libera o sistema.
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  passwordChangedAt  DateTime? @map("password_changed_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  assignments UserAssignment[]
  teamMembers TeamMember[]
  cnesStaged  CnesProfessional[]
  certificates SigningCertificate[]
  signedDocuments SignedDocument[]
  esusBatches  EsusBatch[]

  @@map("users")
}

enum EsusBatchStatus {
  GERADO
  ENVIANDO
  ENVIADO
  PARCIAL
  ERRO
}

enum EsusRecordStatus {
  GERADA
  INVALIDA
  ENVIADA
  ACEITA
  REJEITADA
}

/// Lote de fichas do e-SUS APS (LEDI) de uma unidade e período, gerado a partir dos registros do sistema.
model EsusBatch {
  id          String          @id @default(uuid(7)) @db.Uuid
  unitId      String          @map("unit_id") @db.Uuid
  periodStart DateTime        @map("period_start") @db.Date
  periodEnd   DateTime        @map("period_end") @db.Date
  /// Número sequencial do lote (numLote do DadoTransporte).
  number      Int
  status      EsusBatchStatus @default(GERADO)
  createdBy   String          @map("created_by") @db.Uuid
  createdAt   DateTime        @default(now()) @map("created_at")
  sentAt      DateTime?       @map("sent_at")
  lastError   String?         @map("last_error")

  unit    Unit         @relation(fields: [unitId], references: [id])
  creator User         @relation(fields: [createdBy], references: [id])
  records EsusRecord[]

  @@index([unitId, createdAt])
  @@map("esus_batches")
}

/// Uma ficha do LEDI: tipo (TipoDadoSerializado), origem no sistema, DadoTransporte serializado e situação no PEC.
model EsusRecord {
  id         String           @id @default(uuid(7)) @db.Uuid
  batchId    String           @map("batch_id") @db.Uuid
  /// Código do TipoDadoSerializado (2 FCI, 3 FCD, 4 FAI, 5 FAO, 7 FP, 14 FV...).
  kind       Int
  /// uuidDadoSerializado (CNES-UUID), nome do arquivo .esus.
  uuid       String           @unique
  sourceType String           @map("source_type")
  sourceId   String           @map("source_id") @db.Uuid
  patientId  String?          @map("patient_id") @db.Uuid
  cnes       String           @db.Char(7)
  ine        String?          @db.Char(10)
  status     EsusRecordStatus @default(GERADA)
  /// Inconsistências da validação prévia ou mensagem de recusa do PEC.
  issues     Json             @default("[]")
  /// DadoTransporte serializado (TBinaryProtocol).
  payload    Bytes?
  /// Resumo legível da ficha (profissional, cidadão, data) para a tela.
  summary    Json             @default("{}")
  sentAt     DateTime?        @map("sent_at")
  createdAt  DateTime         @default(now()) @map("created_at")

  batch EsusBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId, status])
  @@index([sourceType, sourceId])
  @@map("esus_records")
}

/// Certificado digital A1 (e-CPF ICP-Brasil) do profissional, guardado cifrado; a senha do arquivo é pedida a cada assinatura.
model SigningCertificate {
  id           String    @id @default(uuid(7)) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  subject      String
  cpf          String    @db.Char(11)
  issuer       String
  serial       String
  notBefore    DateTime  @map("not_before")
  notAfter     DateTime  @map("not_after")
  /// Cadeia emitida por autoridade da ICP-Brasil (false em certificados de teste).
  icpBrasil    Boolean   @map("icp_brasil")
  fingerprint  String    @db.Char(64)
  /// Arquivo PKCS#12 cifrado com AES-256-GCM (chave do servidor).
  pfxEncrypted String    @map("pfx_encrypted")
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now()) @map("created_at")
  revokedAt    DateTime? @map("revoked_at")

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents SignedDocument[]

  @@index([userId, active])
  @@map("signing_certificates")
}

enum SignedKind {
  PRONTUARIO
  RECEITA
  ATESTADO
  DOCUMENTO
}

/// Documento assinado digitalmente (PDF com assinatura PAdES/CMS), vinculado ao registro de origem.
model SignedDocument {
  id            String     @id @default(uuid(7)) @db.Uuid
  kind          SignedKind
  entityType    String     @map("entity_type")
  entityId      String     @map("entity_id") @db.Uuid
  patientId     String?    @map("patient_id") @db.Uuid
  signerId      String     @map("signer_id") @db.Uuid
  certificateId String?    @map("certificate_id") @db.Uuid
  /// SHA-256 do PDF assinado (identifica o arquivo na validação).
  sha256        String     @db.Char(64)
  storageKey    String     @map("storage_key")
  sizeBytes     Int        @map("size_bytes")
  subject       String
  cpf           String     @db.Char(11)
  /// A1_SERVIDOR (certificado guardado no servidor) ou EXTERNA (assinatura feita no navegador/nuvem).
  source        String
  signedAt      DateTime   @default(now()) @map("signed_at")

  signer      User                @relation(fields: [signerId], references: [id])
  certificate SigningCertificate? @relation(fields: [certificateId], references: [id])

  @@index([entityType, entityId])
  @@index([sha256])
  @@map("signed_documents")
}

/// Papel de um profissional em uma unidade (contexto Tenant + Unidade + Papel).
/// Equipe do CNES (INE): eSF, eSB, eMulti, eAP... As fichas do e-SUS e os indicadores do cofinanciamento são por equipe.
model Team {
  id        String   @id @default(uuid(7)) @db.Uuid
  /// Identificador Nacional de Equipe, 10 dígitos.
  ine       String   @unique @db.Char(10)
  name      String
  /// Tipo de equipe do CNES: 70 eSF, 71 eSB, 72 eMulti, 73 eCR, 74 eAPP, 75 eMAESM, 76 eAP.
  typeCode  String   @map("type_code") @db.Char(2)
  unitId    String   @map("unit_id") @db.Uuid
  /// Segmento territorial / área da equipe.
  area      String?
  /// Modalidade para o cofinanciamento (ESF_40H, EAP_30H, EAP_20H, ESB_I, ESB_II, EMULTI_AMPLIADA...).
  modality  String?
  active    Boolean  @default(true)
  source    String   @default("MANUAL")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  unit       Unit         @relation(fields: [unitId], references: [id])
  members    TeamMember[]
  households Household[]

  @@map("teams")
}

/// Membro da equipe: um profissional com acesso (user) ou um pré-cadastro vindo do CNES ainda sem CPF.
model TeamMember {
  id        String  @id @default(uuid(7)) @db.Uuid
  teamId    String  @map("team_id") @db.Uuid
  userId    String? @map("user_id") @db.Uuid
  stagedId  String? @map("staged_id") @db.Uuid
  cbo       String  @db.Char(6)
  microArea String? @map("micro_area")
  active    Boolean @default(true)

  team   Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user   User?             @relation(fields: [userId], references: [id])
  staged CnesProfessional? @relation(fields: [stagedId], references: [id])

  @@unique([teamId, userId])
  @@unique([teamId, stagedId])
  @@map("team_members")
}

enum StagedStatus {
  PENDENTE
  VINCULADO
  IGNORADO
}

/// Profissional vindo do CNES (planilha ou arquivo) que ainda não tem acesso: a gestão completa o CPF ao criar o usuário.
model CnesProfessional {
  id          String       @id @default(uuid(7)) @db.Uuid
  name        String
  cpf         String?      @db.Char(11)
  cns         String?      @db.Char(15)
  cbo         String       @db.Char(6)
  council     String?
  unitId      String?      @map("unit_id") @db.Uuid
  cnes        String?      @db.Char(7)
  ine         String?      @db.Char(10)
  /// Tipo de vínculo no CNES (texto).
  bond        String?
  weeklyHours Int?         @map("weekly_hours")
  source      String
  status      StagedStatus @default(PENDENTE)
  userId      String?      @map("user_id") @db.Uuid
  importId    String?      @map("import_id") @db.Uuid
  importedAt  DateTime     @default(now()) @map("imported_at")

  unit        Unit?        @relation(fields: [unitId], references: [id])
  user        User?        @relation(fields: [userId], references: [id])
  import      CnesImport?  @relation(fields: [importId], references: [id])
  teamMembers TeamMember[]

  @@map("cnes_professionals")
}

enum ImportKind {
  ESTABELECIMENTOS
  PROFISSIONAIS
  EQUIPES
}

enum ImportStatus {
  PREVIA
  APLICADA
  CANCELADA
}

/// Prévia e aplicação de uma importação do CNES (API do DATASUS ou planilha), com o que foi lido e o resultado.
model CnesImport {
  id        String       @id @default(uuid(7)) @db.Uuid
  kind      ImportKind
  ibgeCode  String?      @map("ibge_code")
  source    String
  status    ImportStatus @default(PREVIA)
  summary   Json
  payload   Json
  actorId   String       @map("actor_id") @db.Uuid
  createdAt DateTime     @default(now()) @map("created_at")
  appliedAt DateTime?    @map("applied_at")

  professionals CnesProfessional[]

  @@map("cnes_imports")
}

model UserAssignment {
  id       String  @id @default(uuid(7)) @db.Uuid
  userId   String  @map("user_id") @db.Uuid
  unitId   String  @map("unit_id") @db.Uuid
  role     Role
  /// Ocupação (CBO 2002, 6 dígitos): usada no faturamento e na compatibilidade com a SIGTAP.
  cbo      String  @db.Char(6)
  /// Registro no conselho, ex.: "CRM-SP 123456", "COREN-SP 98765".
  council  String?
  active   Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  unit Unit @relation(fields: [unitId], references: [id])

  @@unique([userId, unitId, role])
  @@map("user_assignments")
}

// ───────────────────────────── Pacientes ─────────────────────────────

enum Sex {
  M
  F
}

model Patient {
  id             String    @id @default(uuid(7)) @db.Uuid
  cns            String?   @unique @db.Char(15)
  cpf            String?   @unique @db.Char(11)
  name           String
  socialName     String?   @map("social_name")
  /// Nome sem acentos e em maiúsculas, para busca e detecção de duplicidade.
  nameKey        String    @map("name_key")
  motherName     String?   @map("mother_name")
  fatherName     String?   @map("father_name")
  birthDate      DateTime  @map("birth_date") @db.Date
  sex            Sex
  racaCor        String    @default("99") @map("raca_cor") @db.Char(2)
  etnia          String?   @db.Char(4)
  nationality    String    @default("010") @db.Char(3)
  phone          String?
  whatsappOptIn  Boolean   @default(false) @map("whatsapp_opt_in")
  email          String?
  cep            String?   @db.Char(8)
  street         String?
  number         String?
  complement     String?
  district       String?
  ibgeCode       String?   @map("ibge_code")
  cadsusSyncedAt DateTime? @map("cadsus_synced_at")
  deceasedAt     DateTime? @map("deceased_at")
  /// Documentos e dados sociais (cadastro individual do e-SUS).
  rg             String?
  rgIssuer       String?   @map("rg_issuer")
  rgUf           String?   @map("rg_uf") @db.Char(2)
  /// NIS/PIS (Bolsa Família e benefícios).
  nis            String?   @db.Char(11)
  birthIbgeCode  String?   @map("birth_ibge_code")
  /// Códigos do e-SUS: escolaridade, situação no mercado de trabalho e parentesco com o responsável familiar.
  education      String?   @db.Char(2)
  workSituation  String?   @map("work_situation") @db.Char(2)
  occupationCbo  String?   @map("occupation_cbo") @db.Char(6)
  homeless       Boolean   @default(false)
  /// Família beneficiária do Bolsa Família.
  bolsaFamilia   Boolean   @default(false) @map("bolsa_familia")
  city           String?
  uf             String?   @db.Char(2)
  familyId       String?   @map("family_id") @db.Uuid
  kinship        String?   @db.Char(2)
  /// Cadastro unificado em outro: sai das buscas e redireciona para o que ficou.
  mergedIntoId   String?   @map("merged_into_id") @db.Uuid
  mergedAt       DateTime? @map("merged_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  family        Family?   @relation("FamilyMembers", fields: [familyId], references: [id])
  responsibleOf Family[]  @relation("FamilyResponsible")
  risks         RiskStratification[]
  mergedInto    Patient?  @relation("PatientMerge", fields: [mergedIntoId], references: [id])
  mergedFrom    Patient[] @relation("PatientMerge")

  allergies   PatientAllergy[]
  conditions  PatientCondition[]
  documents   PatientDocument[]
  encounters  Encounter[]
  appointments Appointment[]
  prescriptions Prescription[]
  examRequests ExamRequest[]
  vaccinations Vaccination[]
  dispensations Dispensation[]
  activeSearchCases ActiveSearchCase[]
  homeVisits  HomeVisit[]
  regulationRequests RegulationRequest[]
  tfdProcesses TfdProcess[]
  transportPassengers TransportPassenger[]
  bedRequests BedRequest[]
  aihRequests AihRequest[]
  accessCodes CitizenAccessCode[]
  assistantConversations AssistantConversation[]
  ombudsmanCases         OmbudsmanCase[]
  surveys                SatisfactionSurvey[]
  notifications          Notification[]

  @@index([nameKey, birthDate])
  @@index([familyId])
  @@map("patients")
}

/// Domicílio (cadastro domiciliar do e-SUS): endereço, condições de moradia e as famílias que vivem nele.
model Household {
  id             String   @id @default(uuid(7)) @db.Uuid
  cep            String?  @db.Char(8)
  street         String?
  number         String?
  complement     String?
  district       String?
  city           String?
  uf             String?  @db.Char(2)
  ibgeCode       String?  @map("ibge_code")
  latitude       Float?
  longitude      Float?
  /// Códigos do e-SUS: tipo de imóvel, tipo de domicílio, situação de moradia, material das paredes, água, esgoto, lixo.
  propertyType   String?  @map("property_type") @db.Char(2)
  dwellingType   String?  @map("dwelling_type") @db.Char(2)
  tenure         String?  @db.Char(2)
  wallMaterial   String?  @map("wall_material") @db.Char(2)
  waterSupply    String?  @map("water_supply") @db.Char(2)
  waterTreatment String?  @map("water_treatment") @db.Char(2)
  sewage         String?  @db.Char(2)
  garbage        String?  @db.Char(2)
  electricity    Boolean?
  rooms          Int?
  animals        String?
  microArea      String?  @map("micro_area")
  unitId         String?  @map("unit_id") @db.Uuid
  teamId         String?  @map("team_id") @db.Uuid
  notes          String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  /// Território (PLT-3): quarteirão do reconhecimento geográfico, sequência do imóvel no quarteirão e zona.
  blockId        String?         @map("block_id") @db.Uuid
  rgSequence     String?         @map("rg_sequence") @db.VarChar(12)
  zone           TerritoryZone?
  /// Precisão e origem da posição (GPS em campo, mapa, base de endereços do IBGE, centro do quarteirão...).
  geoPrecision   GeoPrecision?   @map("geo_precision")
  geoSource      String?         @map("geo_source")
  /// Raio de incerteza em metros, normalizado para 95% de confiança.
  geoAccuracyM   Float?          @map("geo_accuracy_m")
  geoAt          DateTime?       @map("geo_at")

  unit     Unit?    @relation(fields: [unitId], references: [id])
  team     Team?    @relation(fields: [teamId], references: [id])
  block    Block?   @relation(fields: [blockId], references: [id])
  families Family[]
  visits   HomeVisit[]

  @@index([cep])
  @@index([ibgeCode, district])
  @@index([blockId])
  @@index([latitude, longitude])
  @@map("households")
}

enum TerritoryZone {
  URBANA
  RURAL
  PERIURBANA
}

enum GeoPrecision {
  GPS_CAMPO
  MAPA
  ENDERECO
  FACE
  LOGRADOURO
  QUARTEIRAO
  LOCALIDADE
  SETOR
  CEP
  MUNICIPIO
}

/// Localidade do reconhecimento geográfico (PNCD): cidade, vila, povoado, fazenda, sítio... Código de até 8 dígitos
/// único no município entre as ativas (cadastro de localidades do DATASUS).
model Locality {
  id        String        @id @default(uuid(7)) @db.Uuid
  code      String        @db.VarChar(8)
  name      String
  category  String        @default("CIDADE")
  zone      TerritoryZone @default(URBANA)
  /// ATIVA ou EXTINTA (a extinta fica para o histórico).
  status    String        @default("ATIVA")
  geometry  Json?
  minLng    Float?        @map("min_lng")
  minLat    Float?        @map("min_lat")
  maxLng    Float?        @map("max_lng")
  maxLat    Float?        @map("max_lat")
  centerLat Float?        @map("center_lat")
  centerLng Float?        @map("center_lng")
  source    String        @default("MANUAL")
  notes     String?
  createdBy String?       @map("created_by") @db.Uuid
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  neighborhoods Neighborhood[]
  blocks        Block[]

  @@map("localities")
}

/// Bairro ou setor (sublocalidade do PNCD). Os apelidos ligam o nome do cadastro e do Sinan ao polígono.
model Neighborhood {
  id         String   @id @default(uuid(7)) @db.Uuid
  localityId String   @map("locality_id") @db.Uuid
  name       String
  code       String?  @db.VarChar(20)
  /// Limites oficiais (lei de bairros) ou provisórios (desenhados ou vindos de outra base).
  official   Boolean  @default(false)
  aliases    String[] @default([])
  geometry   Json?
  minLng     Float?   @map("min_lng")
  minLat     Float?   @map("min_lat")
  maxLng     Float?   @map("max_lng")
  maxLat     Float?   @map("max_lat")
  centerLat  Float?   @map("center_lat")
  centerLng  Float?   @map("center_lng")
  active     Boolean  @default(true)
  /// Desativado pela extinção da localidade (volta quando ela é reativada).
  inactivatedWithLocality Boolean @default(false) @map("inactivated_with_locality")
  source     String   @default("MANUAL")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  locality Locality @relation(fields: [localityId], references: [id])
  blocks   Block[]

  @@index([localityId])
  @@map("neighborhoods")
}

/// Quarteirão do reconhecimento geográfico: polígono (GeoJSON RFC 7946) e número, único na localidade ou no bairro
/// conforme a regra da instituição (conferida na aplicação).
model Block {
  id             String   @id @default(uuid(7)) @db.Uuid
  localityId     String   @map("locality_id") @db.Uuid
  neighborhoodId String?  @map("neighborhood_id") @db.Uuid
  number         String   @db.VarChar(10)
  geometry       Json
  minLng         Float    @map("min_lng")
  minLat         Float    @map("min_lat")
  maxLng         Float    @map("max_lng")
  maxLat         Float    @map("max_lat")
  centerLat      Float    @map("center_lat")
  centerLng      Float    @map("center_lng")
  areaM2         Float    @map("area_m2")
