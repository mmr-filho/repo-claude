  conversionFactor Decimal @default(1) @map("conversion_factor") @db.Decimal(10, 3)

  product Product @relation(fields: [productId], references: [id])

  @@unique([supplierCnpj, supplierCode])
  @@index([gtin])
  @@map("product_mappings")
}

