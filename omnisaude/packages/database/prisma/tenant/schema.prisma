enum CodeSystem {
  CID10
  CID11
  CIAP2
}

enum LineOfCare {
  HIPERTENSAO
  DIABETES
  GESTANTE
  ONCOLOGIA
  SAUDE_MENTAL
  TUBERCULOSE
  HANSENIASE
  CRIANCA
  IDOSO
  MULHER
  BOLSA_FAMILIA
  SISVAN
}

enum RiskKind {
  GESTANTE
  PE_DIABETICO
  MCHAT
}

/// Estratificação de risco aplicada no atendimento (risco gestacional, pé diabético, M-CHAT-R).
model RiskStratification {
  id          String    @id @default(uuid(7)) @db.Uuid
  patientId   String    @map("patient_id") @db.Uuid
  encounterId String?   @map("encounter_id") @db.Uuid
  kind        RiskKind
  /// Resultado: ALTO_RISCO/RISCO_HABITUAL, grau 0 a 3, BAIXO/MEDIO/ALTO.
  result      String
  score       Int?
  /// Respostas do instrumento (critérios marcados ou itens sim/não).
  answers     Json      @default("{}")
  notes       String?
  /// Data sugerida da próxima avaliação pelo resultado.
  nextDueAt   DateTime? @map("next_due_at") @db.Date
  assessedBy  String    @map("assessed_by") @db.Uuid
  assessedAt  DateTime  @default(now()) @map("assessed_at")

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId, kind, assessedAt])
  @@map("risk_stratifications")
}

model PatientCondition {
  id          String      @id @default(uuid(7)) @db.Uuid
  patientId   String      @map("patient_id") @db.Uuid
  system      CodeSystem
  code        String
  description String
  /// Linha de cuidado acompanhada pelo painel de busca ativa (crônicos e gestantes).
  lineOfCare  LineOfCare? @map("line_of_care")
  onsetAt     DateTime?   @map("onset_at") @db.Date
  active      Boolean     @default(true)
  /// Data do desfecho/resolução (ex.: fim da gestação), preenchida ao inativar a condição.
  resolvedAt  DateTime?   @map("resolved_at") @db.Date
  recordedAt  DateTime    @default(now()) @map("recorded_at")

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([lineOfCare, active])
  @@map("patient_conditions")
}

/// Arquivos guardados no storage de objetos (Cloudflare R2): documentos digitalizados, termos, laudos, PDFs assinados.
