  status         AssistantConversationStatus @default(ABERTA)
  context        Json                        @default("{}")
  /// Gravidade da última triagem de sintomas (EMERGENCIA, URGENCIA, POUCO_URGENTE, NAO_URGENTE).
  lastTriage     String?                     @map("last_triage")
  handoffReason  String?                     @map("handoff_reason")
  messagesCount  Int                         @default(0) @map("messages_count")
  lastInboundAt  DateTime                    @map("last_inbound_at")
  lastOutboundAt DateTime?                   @map("last_outbound_at")
  closedAt       DateTime?                   @map("closed_at")
  createdAt      DateTime                    @default(now()) @map("created_at")
  updatedAt      DateTime                    @updatedAt @map("updated_at")

  patient  Patient?           @relation(fields: [patientId], references: [id])
  messages AssistantMessage[]

  @@index([phone, status])
  @@index([status, lastInboundAt])
  @@map("assistant_conversations")
}

model AssistantMessage {
  id                String             @id @default(uuid(7)) @db.Uuid
  conversationId    String             @map("conversation_id") @db.Uuid
  direction         AssistantDirection
  text              String
  /// Intenção reconhecida (mensagens recebidas) ou tipo da resposta (enviadas).
  intent            String?
  /// Detalhes: botões oferecidos, modelo de IA usado, gravidade, erros.
  payload           Json?
  providerMessageId String?            @map("provider_message_id")
  /// Profissional que respondeu pela tela (mensagens enviadas por pessoa).
  authorId          String?            @map("author_id") @db.Uuid
  createdAt         DateTime           @default(now()) @map("created_at")

  conversation AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("assistant_messages")
}

// ───────────────────────────── Ouvidoria e pesquisa de satisfação (CID-3) ─────────────────────────────

enum OmbudsmanKind {
  RECLAMACAO
  DENUNCIA
  SUGESTAO
  ELOGIO
  SOLICITACAO
  INFORMACAO
}

enum OmbudsmanChannel {
  APP
  WHATSAPP
  PRESENCIAL
  TELEFONE
  SITE
}

enum OmbudsmanStatus {
  RECEBIDA
  EM_ANALISE
  PRORROGADA
  RESPONDIDA
  ENCERRADA
  ARQUIVADA
}

/// Manifestação do cidadão (Lei 13.460/2017): protocolo, prazo de 30 dias prorrogável uma vez, resposta conclusiva e avaliação.
model OmbudsmanCase {
  id              String           @id @default(uuid(7)) @db.Uuid
  protocol        String           @unique
  kind            OmbudsmanKind
  channel         OmbudsmanChannel
  subject         String
  unitId          String?          @map("unit_id") @db.Uuid
  patientId       String?          @map("patient_id") @db.Uuid
  /// Identidade preservada: a equipe não vê nome nem contato (o cidadão continua acompanhando pelo app).
  anonymous       Boolean          @default(false)
  contactName     String?          @map("contact_name")
  contactPhone    String?          @map("contact_phone")
  text            String
  status          OmbudsmanStatus  @default(RECEBIDA)
  receivedAt      DateTime         @default(now()) @map("received_at")
  dueAt           DateTime         @map("due_at")
  extendedAt      DateTime?        @map("extended_at")
  extensionReason String?          @map("extension_reason")
  assignedUnitId  String?          @map("assigned_unit_id") @db.Uuid
  assignedUserId  String?          @map("assigned_user_id") @db.Uuid
  responseText    String?          @map("response_text")
  respondedAt     DateTime?        @map("responded_at")
  respondedBy     String?          @map("responded_by") @db.Uuid
  closedAt        DateTime?        @map("closed_at")
  rating          Int?
  ratingComment   String?          @map("rating_comment")
  ratedAt         DateTime?        @map("rated_at")
  createdBy       String?          @map("created_by") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  patient Patient?         @relation(fields: [patientId], references: [id])
  unit    Unit?            @relation(fields: [unitId], references: [id])
  events  OmbudsmanEvent[]

  @@index([status, dueAt])
  @@index([patientId, createdAt])
  @@index([unitId, status])
  @@map("ombudsman_cases")
}

model OmbudsmanEvent {
  id     String   @id @default(uuid(7)) @db.Uuid
  caseId String   @map("case_id") @db.Uuid
  kind   String
  notes  String?
  userId String?  @map("user_id") @db.Uuid
  at     DateTime @default(now())

  case OmbudsmanCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, at])
  @@map("ombudsman_events")
}

enum SurveyStatus {
  PENDENTE
  RESPONDIDA
  EXPIRADA
}

/// Pesquisa de satisfação enviada após o atendimento (WhatsApp e app do cidadão).
model SatisfactionSurvey {
  id             String       @id @default(uuid(7)) @db.Uuid
  patientId      String       @map("patient_id") @db.Uuid
  encounterId    String?      @unique @map("encounter_id") @db.Uuid
  unitId         String       @map("unit_id") @db.Uuid
  professionalId String?      @map("professional_id") @db.Uuid
  status         SurveyStatus @default(PENDENTE)
  /// Canal da resposta: WHATSAPP ou APP.
  channel        String?
  sentAt         DateTime?    @map("sent_at")
  answeredAt     DateTime?    @map("answered_at")
  /// Nota de 1 (muito ruim) a 5 (ótimo).
  score          Int?
  /// Recomendaria a unidade? 0 a 10 (NPS), só pelo app.
  recommend      Int?
  comment        String?
  expiresAt      DateTime     @map("expires_at")
  createdAt      DateTime     @default(now()) @map("created_at")

  patient   Patient    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  unit      Unit       @relation(fields: [unitId], references: [id])
  encounter Encounter? @relation(fields: [encounterId], references: [id])

  @@index([unitId, createdAt])
  @@index([patientId, status])
  @@map("satisfaction_surveys")
}

// ───────────────────────────── Vigilância epidemiológica: notificação compulsória (VIG-1a) ─────────────────────────────

enum ListScope {
  NACIONAL
  ESTADUAL
  MUNICIPAL
}

enum DiseaseContext {
  CASO
  OBITO
  GESTANTE
  ANOMALIA_CONGENITA
  OUTRO
}

enum NotifyOn {
  SUSPEITA
  CONFIRMACAO
}

enum DeadlineStart {
  ATENDIMENTO
  CONHECIMENTO
  CONFIRMACAO
}

enum NormativeStatus {
  VIGENTE
  EM_REVISAO
}

enum CodeMapStatus {
  PROPOSTO
  HOMOLOGADO
  INATIVO
}

enum NotificationStatus {
  RASCUNHO
  NOTIFICADA
  DESCARTADA
  ENCERRADA
}

enum NotificationOrigin {
  ATENDIMENTO
  OBITO
  INTERNACAO
  MANUAL
  VACINA
  VARREDURA
  EXAME
}

enum NotificationBasis {
  SUSPEITA
  CONFIRMADO
}

enum Sphere {
  SMS
  SES
  MS
  AUTORIDADE_POLICIAL
}

enum CommChannel {
  SISTEMA
  TELEFONE
  EMAIL
  FORMULARIO
  PRESENCIAL
  OUTRO
}

enum DeadlineKind {
  IMEDIATA
  SEMANAL
}

/// Versão da Lista de Notificação Compulsória: nacional (Anexo 1 do Anexo V da PRC 4/2017) ou complementar estadual/municipal.
model NotifiableListVersion {
  id           String    @id @default(uuid(7)) @db.Uuid
  scope        ListScope
  /// "NACIONAL", "ESTADUAL:TO" ou "MUNICIPAL:1709500" (único com valid_from).
  scopeKey     String    @map("scope_key")
  /// Identificador da versão nacional no catálogo do código (ex.: PRT-GM-MS-11211-2026).
  nationalId   String?   @unique @map("national_id")
  uf           String?   @db.Char(2)
  ibgeCode     String?   @map("ibge_code") @db.Char(7)
  act          String
  publishedIn  String?   @map("published_in")
  actUrl       String?   @map("act_url")
  sourceUrl    String?   @map("source_url")
  sourceSha256 String?   @map("source_sha256") @db.Char(64)
  /// SHA-256 do conteúdo da versão nacional no código: muda quando a curadoria muda e dispara a sincronização.
  contentHash  String?   @map("content_hash") @db.Char(64)
  consultedAt  DateTime? @map("consulted_at") @db.Date
  validFrom    DateTime  @map("valid_from") @db.Date
  validTo      DateTime? @map("valid_to") @db.Date
  notes        String?
  createdBy    String?   @map("created_by") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")

  conditions NotifiableCondition[]

  @@unique([scopeKey, validFrom])
  @@map("notifiable_list_versions")
}

model NotifiableCondition {
  id              String          @id @default(uuid(7)) @db.Uuid
  versionId       String          @map("version_id") @db.Uuid
  key             String          @db.VarChar(60)
  groupKey        String          @map("group_key") @db.VarChar(40)
  item            Int
  subitem         String?         @db.Char(1)
  name            String
  context         DiseaseContext
  immediateMs     Boolean         @map("immediate_ms")
  immediateSes    Boolean         @map("immediate_ses")
  immediateSms    Boolean         @map("immediate_sms")
  weekly          Boolean
  notifyOn        NotifyOn        @map("notify_on")
  deadlineStart   DeadlineStart   @map("deadline_start")
  sensitive       Boolean         @default(false)
  /// Notificada uma vez por pessoa (o gatilho não repete).
  once            Boolean         @default(false)
  normativeStatus NormativeStatus @default(VIGENTE) @map("normative_status")
  normativeNote   String?         @map("normative_note")
  sinanCode       String?         @map("sinan_code") @db.VarChar(5)
  active          Boolean         @default(true)

  version       NotifiableListVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@unique([versionId, key])
  @@index([groupKey])
  @@map("notifiable_conditions")
}

/// De-para de código (CID-10/CIAP-2) para grupo de agravo; vale o prefixo mais longo.
model NotifiableCodeMap {
  id            String          @id @default(uuid(7)) @db.Uuid
  system        CodeSystem
  codePrefix    String          @map("code_prefix") @db.VarChar(5)
  groupKey      String          @map("group_key") @db.VarChar(40)
  context       DiseaseContext?
  status        CodeMapStatus   @default(PROPOSTO)
  source        String
  homologatedBy String?         @map("homologated_by") @db.Uuid
  homologatedAt DateTime?       @map("homologated_at")
  createdBy     String?         @map("created_by") @db.Uuid
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  @@unique([system, codePrefix, groupKey])
  @@map("notifiable_code_maps")
}

model Notification {
  id                    String             @id @default(uuid(7)) @db.Uuid
  year                  Int
  seq                   Int
  /// Numeração interna "AAAA/NNNNNN" (não é o número do Sinan).
  number                String             @unique
  status                NotificationStatus @default(RASCUNHO)
  origin                NotificationOrigin
  conditionId           String             @map("condition_id") @db.Uuid
  conditionKey          String             @map("condition_key") @db.VarChar(60)
  groupKey              String             @map("group_key") @db.VarChar(40)
  basis                 NotificationBasis  @default(SUSPEITA)
  codeSystem            CodeSystem?        @map("code_system")
  code                  String?            @db.VarChar(6)
  /// Situação do de-para que disparou o rascunho (PROPOSTO mostra o aviso "não homologado").
  mapStatus             CodeMapStatus?     @map("map_status")
  patientId             String             @map("patient_id") @db.Uuid
  encounterId           String?            @map("encounter_id") @db.Uuid
  noteId                String?            @map("note_id") @db.Uuid
  admissionId           String?            @map("admission_id") @db.Uuid
  vaccinationId         String?            @map("vaccination_id") @db.Uuid
  relatedNotificationId String?            @map("related_notification_id") @db.Uuid
  unitId                String             @map("unit_id") @db.Uuid
  notifierId            String             @map("notifier_id") @db.Uuid
  notifierCbo           String?            @map("notifier_cbo") @db.Char(6)
  notifierRole          Role               @map("notifier_role")
  firstCareAt           DateTime?          @map("first_care_at")
  knownAt               DateTime           @map("known_at")
  confirmedAt           DateTime?          @map("confirmed_at")
  deadlineStart         DeadlineStart      @map("deadline_start")
  deadlineKind          DeadlineKind       @map("deadline_kind")
  targets               Sphere[]
  deadlineStartAt       DateTime?          @map("deadline_start_at")
  dueAt                 DateTime?          @map("due_at")
  notifiedAt            DateTime?          @map("notified_at")
  symptomsOnset         DateTime?          @map("symptoms_onset") @db.Date
  epiWeekNotified       String?            @map("epi_week_notified") @db.Char(6)
  epiWeekOnset          String?            @map("epi_week_onset") @db.Char(6)
  sensitive             Boolean            @default(false)
  /// Retrato dos campos 1 a 33 da Ficha Individual de Notificação do Sinan Net v5.
  form                  Json               @default("{}")
  residenceIbge         String?            @map("residence_ibge") @db.Char(7)
  residenceLat          Float?             @map("residence_lat")
  residenceLng          Float?             @map("residence_lng")
  /// Precisão da posição da residência no retrato da ficha (PLT-3).
  residencePrecision    GeoPrecision?      @map("residence_precision")
  outOfMunicipality     Boolean            @default(false) @map("out_of_municipality")
  smsReceivedAt         DateTime?          @map("sms_received_at")
  smsReceivedBy         String?            @map("sms_received_by") @db.Uuid
  escalatedAt           DateTime?          @map("escalated_at")
  overdueAt             DateTime?          @map("overdue_at")
  discardReason         String?            @map("discard_reason")
  discardedBy           String?            @map("discarded_by") @db.Uuid
  discardedAt           DateTime?          @map("discarded_at")
  /// Sistema oficial de destino (definido na confirmação) e a fila de digitação.
  officialSystem        OfficialSystem?    @map("official_system")
  entryStatus           EntryStatus?       @map("entry_status")
  officialNumber        String?            @map("official_number") @db.VarChar(30)
  officialBatch         String?            @map("official_batch") @db.VarChar(40)
  enteredBy             String?            @map("entered_by") @db.Uuid
  enteredAt             DateTime?          @map("entered_at")
  /// Investigação e encerramento (campos 31 a 43 do Sinan Net v5) e conclusão do e-SUS Sinan.
  investigatedAt        DateTime?          @map("investigated_at") @db.Date
  finalClass            String?            @map("final_class") @db.VarChar(2)
  criterion             String?            @db.VarChar(2)
  evolution             String?            @db.VarChar(1)
  deathDate             DateTime?          @map("death_date") @db.Date
  closedAt              DateTime?          @map("closed_at") @db.Date
  closedBy              String?            @map("closed_by") @db.Uuid
  conclusion            Json?
  /// Violência contra a mulher: comunicação à autoridade policial em 24 h (Anexo V, arts. 14-A a 14-C).
  policeRequired        Boolean            @default(false) @map("police_required")
  policeDueAt           DateTime?          @map("police_due_at")
  policeWaiver          String?            @map("police_waiver")
  createdBy             String?            @map("created_by") @db.Uuid
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")

  condition      NotifiableCondition         @relation(fields: [conditionId], references: [id])
  patient        Patient                     @relation(fields: [patientId], references: [id])
  unit           Unit                        @relation(fields: [unitId], references: [id])
  related        Notification?               @relation("NotificationRelated", fields: [relatedNotificationId], references: [id])
  relatedTo      Notification[]              @relation("NotificationRelated")
  events         NotificationEvent[]
  communications NotificationCommunication[]

  @@unique([year, seq])
  @@index([status, dueAt])
  @@index([patientId, groupKey, createdAt])
  @@index([unitId, status])
  @@index([notifierId, createdAt])
  @@index([encounterId, groupKey])
  @@index([vaccinationId])
  @@index([officialSystem, entryStatus])
  @@map("notifications")
}

model NotificationEvent {
  id             String   @id @default(uuid(7)) @db.Uuid
  notificationId String   @map("notification_id") @db.Uuid
  kind           String
  at             DateTime @default(now())
  userId         String?  @map("user_id") @db.Uuid
  data           Json?
  notes          String?

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([notificationId, at])
  @@map("notification_events")
}

model NotificationCommunication {
  id              String      @id @default(uuid(7)) @db.Uuid
  notificationId  String      @map("notification_id") @db.Uuid
  target          Sphere
  channel         CommChannel
  communicatedAt  DateTime    @map("communicated_at")
  counterpartName String      @map("counterpart_name")
  counterpartOrg  String?     @map("counterpart_org")
  contactId       String?     @map("contact_id") @db.Uuid
  contactValue    String?     @map("contact_value")
  protocol        String?
  notes           String?
  userId          String      @map("user_id") @db.Uuid
  createdAt       DateTime    @default(now()) @map("created_at")

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([notificationId, target])
  @@map("notification_communications")
}

/// Contatos para notificação por esfera (art. 9º do Anexo V): CIEVS nacional, estadual e municipal, plantão.
model SurveillanceContact {
  id        String   @id @default(uuid(7)) @db.Uuid
  sphere    Sphere
  label     String
  phone     String?
  email     String?
  formUrl   String?  @map("form_url")
  hours     String?
  onCall    Boolean  @default(false) @map("on_call")
  active    Boolean  @default(true)
  sort      Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("surveillance_contacts")
}

enum OfficialSystem {
  SINAN_NET
  SINAN_ONLINE
  ESUS_SINAN
  ESUS_NOTIFICA
  SIVEP_GRIPE
  SINASC_SIM
}

enum RouteStatus {
  CONFIRMADO
  A_DEFINIR
  NAO_CONFIRMADO
}

enum EntryStatus {
  PENDENTE
  DIGITADA
  LEMBRETE
}

enum ExamQualitative {
  DETECTAVEL
  NAO_DETECTAVEL
  INCONCLUSIVO
  REAGENTE
  NAO_REAGENTE
  INDETERMINADO
}

/// Rota agravo → sistema oficial de destino, com vigência (a da linha prevalece sobre a do grupo; sem rota, Sinan Net).
model OfficialSystemRoute {
  id           String         @id @default(uuid(7)) @db.Uuid
  groupKey     String         @map("group_key") @db.VarChar(40)
  /// Vazio = vale para o grupo inteiro.
  conditionKey String         @default("") @map("condition_key") @db.VarChar(60)
  system       OfficialSystem
  status       RouteStatus
  validFrom    DateTime       @map("valid_from") @db.Date
  validTo      DateTime?      @map("valid_to") @db.Date
  source       String
  notes        String?
  createdBy    String?        @map("created_by") @db.Uuid
  createdAt    DateTime       @default(now()) @map("created_at")

  @@unique([groupKey, conditionKey, validFrom])
  @@map("official_system_routes")
}

// ───────────────────────────── Endemias: ACE em campo e bloqueio de transmissão (VIG-3a) ─────────────────────────────

enum VectorControlKind {
  LARVICIDA
  ADULTICIDA
}

/// Atividade da visita (boletins de campo do PNCD: 1-LI, 2-LI+T, 3-PE, 4-T, 5-DF, 6-PVE) e o bloqueio de transmissão.
enum VectorActivity {
  LI_T
  LI
  T
  BLOQUEIO
  PE
  DF
  PVE
}

/// Situação do imóvel na visita: trabalhado ou pendente (fechado, recusado, abandonado).
enum VectorVisitSituation {
  TRABALHADO
  FECHADO
  RECUSADO
  ABANDONADO
}

enum BlockingOrderStatus {
  AGUARDANDO_LOCALIZACAO
  ABERTA
  EM_CAMPO
  CONCLUIDA
  CANCELADA
}

/// Baixa do larvicida no estoque: feita na sincronização, pendente (sem saldo, lote desconhecido) ou resolvida depois.
enum TreatmentStockStatus {
  BAIXADO
  PENDENTE
  REGULARIZADO
  CANCELADO
}

/// Zona de trabalho do ACE: o conjunto de quarteirões que ele visita a cada ciclo (PNCD: 800 a 1.000 imóveis).
model VectorZone {
  id        String   @id @default(uuid(7)) @db.Uuid
  /// Unidade de lotação dos agentes (a coordenação de endemias).
  unitId    String   @map("unit_id") @db.Uuid
  name      String
  /// Agente titular; vazio quando a zona está descoberta.
  aceId     String?  @map("ace_id") @db.Uuid
  active    Boolean  @default(true)
  notes     String?
  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  blocks VectorZoneBlock[]

  @@index([aceId])
  @@map("vector_zones")
}

/// Quarteirão da zona (um quarteirão fica em uma zona só).
model VectorZoneBlock {
  zoneId  String @map("zone_id") @db.Uuid
  blockId String @unique @map("block_id") @db.Uuid

  zone VectorZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@id([zoneId, blockId])
  @@map("vector_zone_blocks")
}

/// Visita do ACE ao imóvel (boletim de campo): situação, depósitos, focos, amostras, tratamento e nebulização.
model VectorVisit {
  id                 String               @id @default(uuid(7)) @db.Uuid
  /// UUID gerado no aparelho: o reenvio da sincronização não duplica.
  clientId           String               @unique @map("client_id") @db.Uuid
  userId             String               @map("user_id") @db.Uuid
  unitId             String               @map("unit_id") @db.Uuid
  cbo                String               @db.Char(6)
  householdId        String               @map("household_id") @db.Uuid
  /// Retratos do imóvel na hora da visita (quarteirão, tipo e microárea), para os índices e a ficha do e-SUS.
  blockId            String?              @map("block_id") @db.Uuid
  propertyType       String               @map("property_type") @db.Char(2)
  microArea          String?              @map("micro_area")
  orderId            String?              @map("order_id") @db.Uuid
  activity           VectorActivity
  situation          VectorVisitSituation
  /// Retorno a imóvel que estava pendente no mesmo ciclo (ou na mesma ordem de bloqueio).
  recovery           Boolean              @default(false)
  /// Ciclo bimestral do ano (AAAA-C).
  cycle              String               @db.VarChar(7)
  visitedAt          DateTime             @map("visited_at")
  turno              Int
  syncedAt           DateTime             @default(now()) @map("synced_at")
  /// Contagem por tipo de depósito (A1, A2, B, C, D1, D2, E): inspecionados, com foco, eliminados e tratados.
  deposits           Json?
  depositsInspected  Int                  @default(0) @map("deposits_inspected")
  depositsPositive   Int                  @default(0) @map("deposits_positive")
  depositsEliminated Int                  @default(0) @map("deposits_eliminated")
  depositsTreated    Int                  @default(0) @map("deposits_treated")
  /// Tubitos coletados (número e tipo de depósito), para o laboratório de entomologia.
  samples            Json?
  samplesCount       Int                  @default(0) @map("samples_count")
  /// Nebulização costal no bloqueio: INTRA, PERI ou INTRA_PERI.
  ubv                String?
  education          Boolean              @default(false)
  latitude           Float?
  longitude          Float?
  accuracyM          Float?               @map("accuracy_m")
  notes              String?

  order      BlockingOrder?    @relation(fields: [orderId], references: [id])
  treatments VectorTreatment[]

  @@index([householdId, visitedAt])
  @@index([userId, visitedAt])
  @@index([unitId, visitedAt])
  @@index([blockId, visitedAt])
  @@index([orderId])
  @@map("vector_visits")
}

/// Produto usado na visita, com a baixa por lote no depósito de endemias da unidade.
model VectorTreatment {
  id            String               @id @default(uuid(7)) @db.Uuid
  visitId       String               @map("visit_id") @db.Uuid
  seq           Int
  productId     String               @map("product_id") @db.Uuid
  lotId         String?              @map("lot_id") @db.Uuid
  /// Número do lote como veio do aparelho (mesmo quando não foi achado no estoque).
  lotNumber     String?              @map("lot_number")
  quantity      Decimal              @db.Decimal(12, 3)
  deposits      Int
  locationId    String?              @map("location_id") @db.Uuid
  stockStatus   TreatmentStockStatus @map("stock_status")
  /// SALDO_INSUFICIENTE, LOTE_DESCONHECIDO, LOTE_DE_OUTRO_PRODUTO, LOTE_NAO_INFORMADO ou SEM_DEPOSITO.
  pendingReason String?              @map("pending_reason")
  /// O lote estava vencido na data da visita (fica registrado; o larvicida já foi usado).
  expiredAtUse  Boolean              @default(false) @map("expired_at_use")
  movementId    String?              @map("movement_id") @db.Uuid
  resolvedBy    String?              @map("resolved_by") @db.Uuid
  resolvedAt    DateTime?            @map("resolved_at")
  resolution    String?
  createdAt     DateTime             @default(now()) @map("created_at")

  visit   VectorVisit @relation(fields: [visitId], references: [id], onDelete: Cascade)
  product Product     @relation(fields: [productId], references: [id])
  lot     StockLot?   @relation(fields: [lotId], references: [id])

  @@unique([visitId, seq])
  @@index([stockStatus])
  @@map("vector_treatments")
}

/// Entrada de larvicida recebido por remessa (Ministério da Saúde ou SES, pelo SIES), sem nota fiscal.
model VectorStockReceipt {
  id         String   @id @default(uuid(7)) @db.Uuid
  locationId String   @map("location_id") @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  lotId      String   @map("lot_id") @db.Uuid
  quantity   Decimal  @db.Decimal(12, 3)
  /// Número da guia ou do documento de remessa.
  document   String
  origin     String
  notes      String?
  receivedBy String   @map("received_by") @db.Uuid
  receivedAt DateTime @default(now()) @map("received_at")

  @@unique([document, lotId])
  @@map("vector_stock_receipts")
}

/// Ordem de bloqueio de transmissão: casos próximos (até 2× o raio e 7 dias) numa ação só sobre os quarteirões no raio.
model BlockingOrder {
  id             String              @id @default(uuid(7)) @db.Uuid
  year           Int
  seq            Int
  status         BlockingOrderStatus
  radiusM        Int                 @map("radius_m")
  /// Grupos de agravo dos casos ligados (dengue, chikungunya, zika).
  groups         String[]
  /// Algum caso com posição a conferir (face de quadra ou centro do quarteirão).
  needsCheck     Boolean             @default(false) @map("needs_check")
  openedAt       DateTime            @default(now()) @map("opened_at")
  /// Vazio = aberta pela notificação, sem ação de usuário.
  openedBy       String?             @map("opened_by") @db.Uuid
  startedAt      DateTime?           @map("started_at")
  concludedAt    DateTime?           @map("concluded_at")
  concludedBy    String?             @map("concluded_by") @db.Uuid
  conclusionNote String?             @map("conclusion_note")
  cancelledAt    DateTime?           @map("cancelled_at")
  cancelledBy    String?             @map("cancelled_by") @db.Uuid
  cancelReason   String?             @map("cancel_reason")
  /// Ordem que absorveu esta (o caso ganhou posição perto de outra ordem ativa).
  mergedIntoId   String?             @map("merged_into_id") @db.Uuid
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  cases     BlockingOrderCase[]
  blocks    BlockingOrderBlock[]
  assignees BlockingOrderAssignee[]
  visits    VectorVisit[]

  @@unique([year, seq])
  @@index([status])
  @@map("blocking_orders")
}

/// Notificação ligada à ordem, com o retrato da residência usado no raio (sem nome do paciente).
model BlockingOrderCase {
  id             String        @id @default(uuid(7)) @db.Uuid
  orderId        String        @map("order_id") @db.Uuid
  notificationId String        @unique @map("notification_id") @db.Uuid
  patientId      String        @map("patient_id") @db.Uuid
  householdId    String?       @map("household_id") @db.Uuid
  groupKey       String        @map("group_key") @db.VarChar(40)
  conditionKey   String        @map("condition_key") @db.VarChar(60)
  lat            Float?
  lng            Float?
  precision      GeoPrecision?
  blockId        String?       @map("block_id") @db.Uuid
  /// Início dos sintomas ou, sem ele, a data em que a vigilância soube do caso.
  referenceDate  DateTime      @map("reference_date") @db.Date
  active         Boolean       @default(true)
  linkedAt       DateTime      @default(now()) @map("linked_at")
  unlinkedAt     DateTime?     @map("unlinked_at")
  unlinkReason   String?       @map("unlink_reason")

  order BlockingOrder @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@map("blocking_order_cases")
}

model BlockingOrderBlock {
  orderId   String   @map("order_id") @db.Uuid
  blockId   String   @map("block_id") @db.Uuid
  /// Menor distância de uma residência da ordem até a borda do quarteirão (0 = dentro).
  distanceM Float    @map("distance_m")
  addedAt   DateTime @default(now()) @map("added_at")

  order BlockingOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@id([orderId, blockId])
  @@index([blockId])
  @@map("blocking_order_blocks")
}

/// Agentes designados para executar a ordem (os titulares das zonas atingidas, ajustáveis pela supervisão).
model BlockingOrderAssignee {
  orderId    String   @map("order_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at")
  assignedBy String?  @map("assigned_by") @db.Uuid

  order BlockingOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@id([orderId, userId])
  @@index([userId])
  @@map("blocking_order_assignees")
}
