  fileName     String            @map("file_name")
  content      String
  lines        Int
  controlField String            @map("control_field")
  createdBy    String            @map("created_by") @db.Uuid
  createdAt    DateTime          @default(now()) @map("created_at")

  @@map("billing_exports")
}

// ───────────────────────────── Interoperabilidade e mensageria ─────────────────────────────

enum OutboxKind {
  RNDS_RAC
  RNDS_IMUNIZACAO
  RNDS_DISPENSACAO
  RNDS_SUMARIO_ALTA
}

enum OutboxStatus {
  PENDENTE
  ENVIADO
  ERRO
  DESCARTADO
}

/// Outbox transacional: o registro clínico e a mensagem para a RNDS são gravados na mesma transação.
model OutboxMessage {
  id          String       @id @default(uuid(7)) @db.Uuid
  kind        OutboxKind
  aggregateId String       @map("aggregate_id") @db.Uuid
  payload     Json
  status      OutboxStatus @default(PENDENTE)
  attempts    Int          @default(0)
  lastError   String?      @map("last_error")
  notBefore   DateTime     @default(now()) @map("not_before")
  externalId  String?      @map("external_id")
  sentAt      DateTime?    @map("sent_at")
  createdAt   DateTime     @default(now()) @map("created_at")

  @@index([status, notBefore])
  @@map("outbox_messages")
}

enum MessageKind {
  CONFIRMACAO_CONSULTA
  LEMBRETE_MEDICACAO
  REMARCACAO
  AVISO
}

enum MessageStatus {
  AGENDADA
  ENVIADA
  ENTREGUE
  LIDA
  FALHOU
  CANCELADA
}

model MessageLog {
  id                String        @id @default(uuid(7)) @db.Uuid
  patientId         String?       @map("patient_id") @db.Uuid
  phone             String
  kind              MessageKind
  refId             String?       @map("ref_id") @db.Uuid
  scheduledFor      DateTime      @map("scheduled_for")
  status            MessageStatus @default(AGENDADA)
  providerMessageId String?       @unique @map("provider_message_id")
  payload           Json          @default("{}")
  response          String?
  respondedAt       DateTime?     @map("responded_at")
  sentAt            DateTime?     @map("sent_at")
  error             String?
  createdAt         DateTime      @default(now()) @map("created_at")

  @@index([status, scheduledFor])
  @@index([refId])
  @@map("message_logs")
}

// ───────────────────────────── Serviço social: busca ativa ─────────────────────────────

enum ActiveSearchStatus {
  ABERTO
  EM_CONTATO
  AGENDADO
  ENCERRADO
}

model ActiveSearchCase {
  id          String             @id @default(uuid(7)) @db.Uuid
  patientId   String             @map("patient_id") @db.Uuid
  lineOfCare  LineOfCare         @map("line_of_care")
  status      ActiveSearchStatus @default(ABERTO)
  assignedTo  String?            @map("assigned_to") @db.Uuid
  lastVisitAt DateTime?          @map("last_visit_at")
  openedAt    DateTime           @default(now()) @map("opened_at")
  closedAt    DateTime?          @map("closed_at")
  closeReason String?            @map("close_reason")

  patient  Patient               @relation(fields: [patientId], references: [id])
  contacts ActiveSearchContact[]

  @@index([status, lineOfCare])
  @@map("active_search_cases")
}

model ActiveSearchContact {
  id              String   @id @default(uuid(7)) @db.Uuid
  caseId          String   @map("case_id") @db.Uuid
  channel         String
  outcome         String
  /// Motivos de vulnerabilidade: TRANSPORTE, ABANDONO, BARREIRA_SOCIAL, FINANCEIRA, MOBILIDADE...
  vulnerabilities String[]
  /// Ações tomadas: TRANSPORTE_SANITARIO, VISITA_DOMICILIAR, CONSULTA_AGENDADA...
  actions         String[]
  notes           String?
  userId          String   @map("user_id") @db.Uuid
  at              DateTime @default(now())

  case ActiveSearchCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@map("active_search_contacts")
}

// ───────────────────────────── Gestão ─────────────────────────────

model MeetingAgenda {
  id          String   @id @default(uuid(7)) @db.Uuid
  periodStart DateTime @map("period_start")
  periodEnd   DateTime @map("period_end")
  scope       String
  content     Json
  markdown    String
  createdBy   String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("meeting_agendas")
}

model BiQueryLog {
