  @@index([unitId, cbo, status])
  @@map("waitlist_entries")
}

// ───────────────────────────── Regulação ambulatorial (fila única) ─────────────────────────────

enum RegulationKind {
  CONSULTA
  EXAME
  PROCEDIMENTO
}

enum RegulationPriority {
  VERMELHA
  AMARELA
  VERDE
  AZUL
}

enum RegulationStatus {
  PENDENTE
  EM_ANALISE
  DEVOLVIDA
  AUTORIZADA
  AGENDADA
  NEGADA
  CANCELADA
  REALIZADA
}

enum ProviderKind {
  PROPRIO
  CONTRATADO
  FILANTROPICO
  CONSORCIADO
}

/// Prestador executante da regulação: unidade da rede própria ou serviço contratado, com contrato e tetos.
model RegulationProvider {
  id               String       @id @default(uuid(7)) @db.Uuid
  name             String
  kind             ProviderKind
  /// Unidade da rede quando o prestador é próprio (agendas e atendimento acontecem nela).
  unitId           String?      @map("unit_id") @db.Uuid
  cnes             String?      @db.Char(7)
  cnpj             String?      @db.Char(14)
  contractNumber   String?      @map("contract_number")
  contractStart    DateTime?    @map("contract_start") @db.Date
  contractEnd      DateTime?    @map("contract_end") @db.Date
  /// Teto físico (procedimentos por mês) e financeiro (R$ por mês) do contrato.
  physicalCeiling  Int?         @map("physical_ceiling")
  financialCeiling Decimal?     @map("financial_ceiling") @db.Decimal(14, 2)
  phone            String?
  address          String?
  notes            String?
  active           Boolean      @default(true)
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  quotas   RegulationQuota[]
  requests RegulationRequest[]

  @@map("regulation_providers")
}

/// PPI e cotas: quantidade pactuada por competência, tipo e especialidade/procedimento, opcionalmente reservada a uma unidade solicitante.
model RegulationQuota {
  id           String         @id @default(uuid(7)) @db.Uuid
  providerId   String         @map("provider_id") @db.Uuid
  competencia  String         @db.Char(7)
  kind         RegulationKind
  specialty    String
  quantity     Int
  unitValue    Decimal?       @map("unit_value") @db.Decimal(12, 2)
  originUnitId String?        @map("origin_unit_id") @db.Uuid
  notes        String?
  createdAt    DateTime       @default(now()) @map("created_at")

  provider RegulationProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([competencia, kind, specialty])
  @@index([providerId, competencia])
  @@map("regulation_quotas")
}

/// Solicitação de consulta especializada, exame ou procedimento feita a partir do atendimento e regulada na fila única.
model RegulationRequest {
  id                    String             @id @default(uuid(7)) @db.Uuid
  /// Número de protocolo legível (REG-AAAA-NNNNNN), único no tenant.
  protocol              String             @unique
  kind                  RegulationKind
  /// Código da especialidade ou do procedimento regulado (tabela compartilhada) e o procedimento SIGTAP.
  specialty             String
  procedureCode         String             @map("procedure_code") @db.Char(10)
  procedureName         String             @map("procedure_name")
  patientId             String             @map("patient_id") @db.Uuid
  encounterId           String?            @map("encounter_id") @db.Uuid
  unitId                String             @map("unit_id") @db.Uuid
  requesterId           String             @map("requester_id") @db.Uuid
  requesterCbo          String             @map("requester_cbo") @db.Char(6)
  priority              RegulationPriority
  priorityJustification String?            @map("priority_justification")
  clinicalSummary       String             @map("clinical_summary")
  /// Critérios do protocolo marcados pelo solicitante.
  criteria              String[]
  cid                   String?            @db.VarChar(5)
  /// Pendências apontadas pela verificação do protocolo na solicitação.
  protocolIssues        String[]           @map("protocol_issues")
  status                RegulationStatus   @default(PENDENTE)
  /// Prioridade original quando o regulador reclassifica.
  requestedPriority     RegulationPriority @map("requested_priority")
  regulatorId           String?            @map("regulator_id") @db.Uuid
  decisionAt            DateTime?          @map("decision_at")
  decisionReason        String?            @map("decision_reason")
  providerUnitId        String?            @map("provider_unit_id") @db.Uuid
  /// Prestador, cota consumida e competência da autorização (REG-3).
  providerId            String?            @map("provider_id") @db.Uuid
  quotaId               String?            @map("quota_id") @db.Uuid
  competencia           String?            @db.Char(7)
  appointmentId         String?            @map("appointment_id") @db.Uuid
  scheduledAt           DateTime?          @map("scheduled_at")
  noShowCount           Int                @default(0) @map("no_show_count")
  returnedCount         Int                @default(0) @map("returned_count")
  /// Código da solicitação no SISREG ou no e-SUS Regulação, quando também registrada lá.
  externalCode          String?            @map("external_code")
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")
  closedAt              DateTime?          @map("closed_at")

  patient     Patient                @relation(fields: [patientId], references: [id])
  provider    RegulationProvider?    @relation(fields: [providerId], references: [id])
  events      RegulationEvent[]
  attachments RegulationAttachment[]

  @@index([status, priority, createdAt])
  @@index([unitId, status])
  @@index([patientId, createdAt])
  @@index([specialty, status])
  @@map("regulation_requests")
}

/// Histórico da solicitação: mudanças de situação e mensagens entre solicitante e regulador (devolutiva).
model RegulationEvent {
  id         String            @id @default(uuid(7)) @db.Uuid
  requestId  String            @map("request_id") @db.Uuid
  kind       String
  fromStatus RegulationStatus? @map("from_status")
  toStatus   RegulationStatus? @map("to_status")
  userId     String            @map("user_id") @db.Uuid
  role       Role
  notes      String?
  at         DateTime          @default(now())

  request RegulationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, at])
  @@map("regulation_events")
}

/// Anexos da solicitação: documentos do paciente (laudos, exames) já guardados no storage.
model RegulationAttachment {
  id         String   @id @default(uuid(7)) @db.Uuid
  requestId  String   @map("request_id") @db.Uuid
  documentId String   @map("document_id") @db.Uuid
  label      String?
  at         DateTime @default(now())

  request RegulationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([requestId, documentId])
  @@map("regulation_attachments")
}

// ───────────────────────────── TFD e transporte sanitário ─────────────────────────────

enum TfdStatus {
  ABERTO
  ENVIADO
  DEFERIDO
  INDEFERIDO
  AGENDADO
  CONCLUIDO
  CANCELADO
}

/// Processo de Tratamento Fora do Domicílio (Portaria SAS/MS 55/1999): laudo, envio, parecer, agendamento, ajuda de custo e viagem.
model TfdProcess {
  id                 String    @id @default(uuid(7)) @db.Uuid
  protocol           String    @unique
  patientId          String    @map("patient_id") @db.Uuid
  requestId          String?   @map("request_id") @db.Uuid
  unitId             String    @map("unit_id") @db.Uuid
  requesterId        String    @map("requester_id") @db.Uuid
  requesterCbo       String    @map("requester_cbo") @db.Char(6)
  cid                String?   @db.VarChar(5)
  diagnosis          String
  procedureName      String    @map("procedure_name")
  procedureCode      String?   @map("procedure_code") @db.Char(10)
  clinicalSummary    String    @map("clinical_summary")
  /// Por que o tratamento não é possível no município (exigência do TFD).
  justification      String
  urgency            Boolean   @default(false)
  destinationCity    String    @map("destination_city")
  destinationUf      String    @map("destination_uf") @db.Char(2)
  destinationIbge    String?   @map("destination_ibge")
  destinationUnit    String?   @map("destination_unit")
  transport          String
  needsCompanion     Boolean   @default(false) @map("needs_companion")
  companionName      String?   @map("companion_name")
  companionCpf       String?   @map("companion_cpf") @db.Char(11)
  companionRelation  String?   @map("companion_relation")
  accommodation      Boolean   @default(false)
  status             TfdStatus @default(ABERTO)
  sentAt             DateTime? @map("sent_at")
  opinionAt          DateTime? @map("opinion_at")
  opinionBy          String?   @map("opinion_by") @db.Uuid
  opinionNotes       String?   @map("opinion_notes")
  allowanceApproved  Boolean   @default(false) @map("allowance_approved")
  appointmentAt      DateTime? @map("appointment_at")
  appointmentPlace   String?   @map("appointment_place")
  appointmentNotes   String?   @map("appointment_notes")
  /// Itens da ajuda de custo: [{ tipo, beneficiario, quantidade, valorUnitario, descricao }].
  allowance          Json      @default("[]")
  allowanceTotal     Decimal   @default(0) @map("allowance_total") @db.Decimal(12, 2)
  allowancePaidAt    DateTime? @map("allowance_paid_at")
  tripId             String?   @map("trip_id") @db.Uuid
  closedAt           DateTime? @map("closed_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  patient Patient    @relation(fields: [patientId], references: [id])
  events  TfdEvent[]

  @@index([status, createdAt])
  @@index([patientId])
  @@index([unitId, status])
  @@map("tfd_processes")
}

model TfdEvent {
  id         String     @id @default(uuid(7)) @db.Uuid
  processId  String     @map("process_id") @db.Uuid
  kind       String
  fromStatus TfdStatus? @map("from_status")
  toStatus   TfdStatus? @map("to_status")
  userId     String     @map("user_id") @db.Uuid
  role       Role
  notes      String?
  at         DateTime   @default(now())

  process TfdProcess @relation(fields: [processId], references: [id], onDelete: Cascade)

  @@index([processId, at])
  @@map("tfd_events")
}

// ───────────────────────────── Regulação de leitos da rede e AIH (REG-7) ─────────────────────────────

enum BedRequestStatus {
  PENDENTE
  EM_ANALISE
  DEVOLVIDA
  AUTORIZADA
  EM_TRANSFERENCIA
  INTERNADA
  NEGADA
  CANCELADA
}

/// Solicitação de vaga/internação à central de leitos da rede.
model BedRequest {
  id                 String             @id @default(uuid(7)) @db.Uuid
  /// LEI-AAAA-NNNNNN, único no tenant.
  protocol           String             @unique
  patientId          String             @map("patient_id") @db.Uuid
  encounterId        String?            @map("encounter_id") @db.Uuid
  originUnitId       String             @map("origin_unit_id") @db.Uuid
  requesterId        String             @map("requester_id") @db.Uuid
  requesterCbo       String             @map("requester_cbo") @db.Char(6)
  bedKind            WardKind           @map("bed_kind")
  specialty          String
  priority           RegulationPriority
  requestedPriority  RegulationPriority @map("requested_priority")
  cid                String?            @db.VarChar(5)
  clinicalSummary    String             @map("clinical_summary")
  /// Sinais vitais informados (PA, FC, FR, SatO2, temperatura, consciência, oxigênio).
  vitals             Json?
  /// Suporte em uso: ventilação mecânica, droga vasoativa, oxigênio, diálise.
  support            Json               @default("{}")
  news2              Int?
  isolation          Isolation          @default(NENHUM)
  elective           Boolean            @default(false)
  status             BedRequestStatus   @default(PENDENTE)
  regulatorId        String?            @map("regulator_id") @db.Uuid
  decisionAt         DateTime?          @map("decision_at")
  decisionReason     String?            @map("decision_reason")
  secondOpinionAt    DateTime?          @map("second_opinion_at")
  secondOpinionBy    String?            @map("second_opinion_by") @db.Uuid
  secondOpinionNotes String?            @map("second_opinion_notes")
  destinationUnitId  String?            @map("destination_unit_id") @db.Uuid
  destinationKind    WardKind?          @map("destination_kind")
  reservedBedId      String?            @map("reserved_bed_id") @db.Uuid
  transport          String?
  transferAt         DateTime?          @map("transfer_at")
  transferNotes      String?            @map("transfer_notes")
  admissionId        String?            @unique @map("admission_id") @db.Uuid
  returnedCount      Int                @default(0) @map("returned_count")
  /// Procedimento SIGTAP da internação (exigido pelo MIRA para o envio à RNDS).
  procedureCode      String?            @map("procedure_code") @db.Char(10)
  /// Código da solicitação no SISREG ou no e-SUS Regulação, quando também registrada lá.
  externalCode       String?            @map("external_code")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  closedAt           DateTime?          @map("closed_at")

  patient     Patient           @relation(fields: [patientId], references: [id])
  reservedBed Bed?              @relation(fields: [reservedBedId], references: [id])
  admission   Admission?        @relation(fields: [admissionId], references: [id])
  events      BedRequestEvent[]
  aihRequests AihRequest[]

  @@index([status, priority, createdAt])
  @@index([patientId])
  @@index([originUnitId, status])
  @@index([destinationUnitId, status])
  @@map("bed_requests")
}

model BedRequestEvent {
  id         String            @id @default(uuid(7)) @db.Uuid
  requestId  String            @map("request_id") @db.Uuid
  kind       String
  fromStatus BedRequestStatus? @map("from_status")
  toStatus   BedRequestStatus? @map("to_status")
  userId     String            @map("user_id") @db.Uuid
