{
  "name": "@omnisaude/database",
  "version": "0.1.0",
  "private": true,
  "description": "Esquemas do master_auth_db e do tenant_db (Prisma), migra\u00e7\u00f5es e roteamento de conex\u00f5es por tenant.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "prisma"
  ],
  "scripts": {
    "generate": "prisma generate --config prisma.master.config.ts && prisma generate --config prisma.tenant.config.ts",
    "build": "npm run generate && tsc -b",
    "migrate": "node dist/cli.js migrate",
    "seed": "node dist/cli.js seed",
    "tenant:create": "node dist/cli.js tenant:create",
    "test": "vitest run --root ../.. --project packages packages/database/test"
  },
  "dependencies": {
    "@omnisaude/shared": "0.1.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/pg": "^8.15.0",
    "prisma": "7.10.1"
  },
  "bin": {
    "omnisaude-db": "dist/cli.js"
  }
}
