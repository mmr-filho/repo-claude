# API do OmniSaúde: copie para .env e ajuste. Valores de desenvolvimento; em produção use o cofre de segredos.
PORT=3001
MASTER_DATABASE_URL=postgresql://omni_app:omni_app@localhost:5432/master_auth_db
TENANT_DB_HOST=localhost
TENANT_DB_PORT=5432
# Réplica de leitura (BI / Text-to-SQL). Sem réplica, o BI usa o primário com o papel somente leitura.
TENANT_REPLICA_HOST=
TENANT_REPLICA_PORT=
TENANT_DB_USER=omni_app
TENANT_DB_PASSWORD=omni_app
TENANT_ADMIN_USER=omni_admin
TENANT_ADMIN_PASSWORD=omni_admin
TENANT_BI_USER=omni_bi_reader
TENANT_BI_PASSWORD=omni_bi
# Pelo menos 32 caracteres aleatórios
JWT_SECRET=troque-este-segredo-de-desenvolvimento-32+
# 32 bytes em base64 (ex.: openssl rand -base64 32)
DATA_KEY=BwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwc=
CORS_ORIGINS=http://localhost:3000,capacitor://localhost,https://localhost
# REDIS_URL=redis://localhost:6379
RUN_JOBS=true
MOCKS_URL=http://localhost:4010
RNDS_REQUESTER_CPF=52998224725
WHATSAPP_VERIFY_TOKEN=verificacao-dev
LIBRAS_INTERPRETER_KEY=central-libras-dev
