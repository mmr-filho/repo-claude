{
  "name": "@omnisaude/api",
  "version": "0.1.0",
  "private": true,
  "description": "API NestJS do OmniSaúde: REST, WebSockets, filas e jobs em segundo plano.",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -b",
    "start": "node dist/main.js",
    "dev": "tsc -b && node --watch dist/main.js",
    "worker": "node dist/worker.js",
    "test": "vitest run --root ../.. --project api"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1160.0",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/platform-express": "^11.2.8",
    "@nestjs/platform-socket.io": "^11.2.8",
    "@nestjs/websockets": "^11.2.8",
    "@omnisaude/accessibility": "0.1.0",
    "@omnisaude/ai-engine": "0.1.0",
    "@omnisaude/database": "0.1.0",
    "@omnisaude/fhir": "0.1.0",
    "@omnisaude/esus": "0.1.0",
    "@omnisaude/messaging": "0.1.0",
    "@omnisaude/shared": "0.1.0",
    "@signpdf/placeholder-pdf-lib": "^4.0.0",
    "@signpdf/signpdf": "^4.0.0",
    "@signpdf/utils": "^4.0.0",
    "bullmq": "^5.81.0",
    "fast-xml-parser": "^5.11.0",
    "ioredis": "^5.11.0",
    "jose": "^6.2.0",
    "node-forge": "^1.4.2",
    "pdf-lib": "^1.17.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.1",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.8",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node-forge": "^1.3.14",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.4"
  }
}
